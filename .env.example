# Optional: supply your own values through the shell environment.
# Production: https://buffalobillsacademy.com (leave unset for ordinary local development).
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
SLACK_BOT_TOKEN=
# Channel id (C…) or #name for Academy channel posts such as wanted posters.
# Default (if this and the admin setting are both empty) is #buffalo-bills-academy.
SLACK_ACADEMY_CHANNEL=#buffalo-bills-academy
# Set to 0 to kill wanted-poster posts even when a channel is configured.
SLACK_WANTED_POSTERS=

# Optional ConquestK account links and play-money sportsbook.
# Use a dedicated server credential shared with the ConquestK integration.
CONQUESTK_URL=https://conquestk.com
CONQUESTK_SERVICE_TOKEN=
CONQUESTK_BETTING_ENABLED=false
# Optional Academy player IDs allowed to place new bets during a pilot.
CONQUESTK_PILOT_PLAYER_IDS=

# Optional stable player ID for the Gunnar house easter egg.
GUNNAR_ROOM_PLAYER_ID=
